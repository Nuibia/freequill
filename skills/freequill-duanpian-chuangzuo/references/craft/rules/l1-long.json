      "priority": "hard-gate",
      "conflicts": { "wins_over": ["L3 单章独立性"], "yields_to": ["冻结正史与状态"] },
      "operator_refs": ["OP-LONG-CONTINUITY-001"],
      "template_refs": ["chapter-snapshot.template.json", "long-chapter-plan.template.json"],
      "eval_refs": ["RUBRIC-LONG-PLAN-001", "RUBRIC-LONG-REVIEW-001"]
    },
    {
