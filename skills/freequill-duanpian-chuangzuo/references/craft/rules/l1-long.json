      "mechanism": "正文、候选正史、状态与快照先闭合并冻结哈希，再交隔离评审；通过后按同一组哈希共同签出。",
      "procedure": ["生成正文与连续性候选", "计算四类哈希", "冻结评审输入", "隔离评审", "只在全绿时共同落盘", "任一内容变化使旧评审失效"],
      "observable_results": ["交付回执含同批 body/canon/state/snapshot hash", "正文与账本 revision 一致"],
      "misuse_signals": ["评审通过后正文哈希变化", "账本晚于正文补写", "快照引用旧 revision"],
      "priority": "absolute",
      "conflicts": { "wins_over": ["先发后补账"], "yields_to": ["无"] },
      "operator_refs": ["OP-LONG-FREEZE-001"],
