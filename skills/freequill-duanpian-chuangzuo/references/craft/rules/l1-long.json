      "conflicts": { "wins_over": ["L3 临时惊奇"], "yields_to": ["正史与公平信息"] },
      "operator_refs": ["OP-LONG-HOOK-001"],
      "template_refs": ["canon-ledger.template.json", "long-chapter-plan.template.json"],
      "eval_refs": ["RUBRIC-LONG-PLAN-001", "RUBRIC-LONG-REVIEW-001"]
    },
    {
      "rule_id": "CRAFT-L1-LONG-CONTINUITY-001",
      "applies_to": ["chapter-plan", "draft", "revision", "review"],
      "triggers": ["跨章目标重置", "人物情绪无过渡", "旧代价下一章消失"],
